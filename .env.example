OPENCODE_API_KEY=
OPENCODE_VLM_MODEL=qwen3.7-plus
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# TOML overlay for model labels / pricing / enabled (not capabilities).
# Repo models.toml whitelists qwen3.7-plus + minimax-m3 for deploy.
PDF2MD_MODEL_REGISTRY=./models.toml

# OCR page cache directory (shared by CLI, web, worker)
# PDF2MD_CACHE_DIR=

# --- Web app (optional: uv sync --extra web) ---
# DATABASE_URL=postgresql+psycopg://smartmd:smartmd@localhost:5432/smartmd
# REDIS_URL=redis://localhost:6379/0
# WEB_DATA_DIR=./data/web
# WEB_DEFAULT_CREDITS=10
# WEB_SECRET_KEY=change-me-in-production
# WEB_MAX_UPLOAD_MB=50
# WEB_SESSION_DAYS=14
# Secure session/CSRF cookies (default true). Use false only for local HTTP.
# COOKIE_SECURE=false
# Public self-serve signup (default false). Set true only when you want open registration.
# WEB_ALLOW_REGISTER=true
# Bootstrap first admin (pdf2md-admin); prefer CLI flags over env in shared shells.
# WEB_BOOTSTRAP_ADMIN_EMAIL=
# WEB_BOOTSTRAP_ADMIN_PASSWORD=
# RQ job timeout floor (seconds); actual = max(floor, ocr_pages * per_page)
# WEB_JOB_TIMEOUT_SECONDS=1800
# WEB_JOB_TIMEOUT_PER_PAGE_SECONDS=180
# Parallel OCR threads per render batch
# WEB_OCR_CONCURRENCY=4

# --- Tests ---
# TEST_DATABASE_URL=postgresql+psycopg://smartmd:smartmd@localhost:5432/smartmd_test
# PDF2MD_WEB_E2E=0
# PDF2MD_OCR_E2E=0
